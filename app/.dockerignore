# The image needs the solution's build files and src/ only. Everything else
# stays out of the build context, above all .env, which holds the local
# passcode, and any bin/ or obj/ from a local build.
*
!global.json
!Directory.Build.props
!Obsview.slnx
!src/
src/**/bin/
src/**/obj/
**/.env
**/.env.*
