<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- CA1707: test names read as sentences, as the Python suite's did.
         CA1861: inline arrays of expected values are what a test reads best.
         xUnit1051: every query here is in memory and finishes at once, so
         threading the test's cancellation token through each call buys nothing. -->
    <NoWarn>$(NoWarn);CA1707;CA1861;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Obsview\Obsview.csproj" />
  </ItemGroup>

</Project>
