            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Deployments_CL\n| where $__timeFilter(TimeGenerated)\n| where Environment == \"$environment\"\n| summarize n = countif(Outcome == \"rolled_back\")",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
