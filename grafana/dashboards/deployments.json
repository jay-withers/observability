{
  "uid": "deployments",
  "title": "Deployments",
  "description": "Every run of jay-withers/workflows' container-apps-deploy.yml, from Deployments_CL. Provisioned from jay-withers/observability: edit the JSON there, not here.",
  "tags": [
    "platform",
    "deployments"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "dev",
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": true
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Deploys",
      "description": "Runs of container-apps-deploy.yml in the range, whatever the outcome.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Deployments_CL\n| where $__timeFilter(TimeGenerated)\n| where Environment == \"$environment\"\n| count",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Success rate",
      "description": "Deploys that went live: smoke-tested, or untested where the repo has no smoke target.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Deployments_CL\n| where $__timeFilter(TimeGenerated)\n| where Environment == \"$environment\"\n| summarize rate = 100.0 * countif(Outcome in (\"success\", \"untested\")) / count()",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
