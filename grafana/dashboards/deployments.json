    {
      "id": 7,
      "type": "timeseries",
      "title": "Deploys per day, by trigger",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Deployments_CL\n| where $__timeFilter(TimeGenerated)\n| where Environment == \"$environment\"\n| summarize Deploys = count() by bin(TimeGenerated, 1d), Trigger\n| order by TimeGenerated asc",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "time_series",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outcomes per day",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Deployments_CL\n| where $__timeFilter(TimeGenerated)\n| where Environment == \"$environment\"\n| summarize Deploys = count() by bin(TimeGenerated, 1d), Outcome\n| order by TimeGenerated asc",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "time_series",
