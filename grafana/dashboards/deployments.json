    {
      "id": 9,
      "type": "table",
      "title": "By app",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Deployments_CL\n| where $__timeFilter(TimeGenerated)\n| where Environment == \"$environment\"\n| summarize Deploys = count(),\n            SuccessPct = round(100.0 * countif(Outcome in (\"success\", \"untested\")) / count(), 1),\n            RolledBack = countif(Outcome == \"rolled_back\"),\n            Failed = countif(Outcome == \"failed\"),\n            MedianLeadTime = percentile(LeadTimeSec, 50),\n            arg_max(TimeGenerated, Version, Outcome)\n          by Repo, App\n| project Repo, App, ['Last deploy'] = TimeGenerated, ['Last version'] = Version, ['Last outcome'] = Outcome,\n          Deploys, ['Success %'] = SuccessPct, ['Rolled back'] = RolledBack, Failed, ['Median lead time'] = MedianLeadTime\n| order by ['Last deploy'] desc",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Median lead time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Recent deploys",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Deployments_CL\n| where $__timeFilter(TimeGenerated)\n| where Environment == \"$environment\"\n| project TimeGenerated, Repo, App, Version, PreviousVersion, Outcome, Trigger, LeadTimeSec, CommitSha = substring(CommitSha, 0, 7), RunUrl\n| order by TimeGenerated desc\n| take 100",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RunUrl"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Run"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the Actions run",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "LeadTimeSec"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Lead time"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Outcome"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "index": 0
                      },
                      "untested": {
                        "color": "blue",
                        "index": 1
                      },
                      "rolled_back": {
                        "color": "orange",
                        "index": 2
                      },
                      "failed": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
