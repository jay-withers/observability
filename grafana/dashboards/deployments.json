        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Renovate share",
      "description": "Deploys whose released commit was a Renovate merge.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Deployments_CL\n| where $__timeFilter(TimeGenerated)\n| where Environment == \"$environment\"\n| summarize share = 100.0 * countif(Trigger == \"renovate\") / count()",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ],
      "options": {
        "reduceOptions": {
