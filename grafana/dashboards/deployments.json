    {
      "id": 5,
      "type": "stat",
      "title": "Median lead time",
      "description": "From the released commit to live.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Deployments_CL\n| where $__timeFilter(TimeGenerated)\n| where Environment == \"$environment\"\n| summarize p50 = percentile(LeadTimeSec, 50)",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
