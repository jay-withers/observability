    {
      "id": 5,
      "type": "table",
      "title": "Jobs",
      "description": "Latest heartbeat per Container Apps job, from observability's hourly check. Cadence is learned from 30 days of system logs, so there is no job list to keep up to date.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "OpsEvents_CL\n| where TimeGenerated > ago(3h)\n| where Kind == \"heartbeat\" and Environment == \"$environment\"\n| summarize arg_max(TimeGenerated, Status, Detail, RunUrl, Repo) by Name\n| project Name, Status, Detail, Checked = TimeGenerated, RunUrl\n| order by Status == \"ok\" asc, Name asc",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table",
            "dashboardTime": false,
            "timeColumn": "TimeGenerated"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "drifted": {
                        "color": "orange",
                        "index": 1
                      },
                      "expiring": {
                        "color": "orange",
                        "index": 2
                      },
                      "overdue": {
                        "color": "red",
                        "index": 3
                      },
                      "failed": {
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RunUrl"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Run"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the Actions run",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Failed job runs",
      "description": "Executions that ended in a failure reason, in the dashboard's time range. DeadlineExceeded (ran past its timeout) is listed here but not alerted on by workload_crashed.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "ContainerAppSystemLogs_CL\n| where $__timeFilter(TimeGenerated)\n| where isnotempty(JobName_s)\n| where Reason_s in (\"BackoffLimitExceeded\", \"DeadlineExceeded\", \"ContainerCrashing\", \"StartError\")\n| summarize Failures = count(), LastFailure = max(TimeGenerated), Sample = take_any(Log_s) by Job = JobName_s, Reason = Reason_s\n| order by LastFailure desc",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
