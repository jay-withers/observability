            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "OpsEvents_CL\n| where TimeGenerated > ago(3h)\n| where Kind == \"heartbeat\" and Environment == \"$environment\"\n| summarize arg_max(TimeGenerated, Status, Detail, RunUrl, Repo) by Name\n| where Status == \"overdue\"\n| count",
