{
  "uid": "jobs-and-ops",
  "title": "Jobs and ops",
  "description": "Liveness: job heartbeats, failed job runs, Terraform drift and certificate expiry, from OpsEvents_CL and ContainerAppSystemLogs_CL. Provisioned from jay-withers/observability: edit the JSON there, not here.",
  "tags": [
    "platform",
    "operations"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "dev",
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": true
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Problems now",
      "description": "Checks whose latest result is failed, drifted, expiring or overdue: what the platform's ops_event_bad alert is firing on.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "OpsEvents_CL\n| where TimeGenerated > ago(2d)\n| where Environment == \"$environment\"\n| summarize arg_max(TimeGenerated, Status) by Kind, Name\n| where Status in (\"failed\", \"drifted\", \"expiring\", \"overdue\")\n| count",
            "resources": [
              "__WORKSPACE_RESOURCE_ID__"
            ],
            "resultFormat": "table",
            "dashboardTime": false,
            "timeColumn": "TimeGenerated"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
